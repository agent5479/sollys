{
  "name": "@whitelabel/pivot-kit",
  "version": "0.1.0",
  "description": "Standalone white-label pivot toolkit: intake config, generators, brand/SEO gates, provision, E2E, cutover",
  "type": "module",
  "bin": {
    "wl": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "wl": "tsx src/cli.ts",
    "validate:example": "tsx src/cli.ts validate --config examples/client.config.example.json",
    "generate:example": "tsx src/cli.ts generate --config examples/client.config.example.json --out .tmp/generated",
    "check-brand:clean": "tsx src/cli.ts check-brand --previous examples/previous-brand.tokens.json --root fixtures/brand-clean",
    "check-seo:fixtures": "tsx src/cli.ts check-seo --root fixtures/seo-ok",
    "test:unit": "tsx --test src/config/load.test.ts src/e2e/j2-smoke.test.ts src/intake.test.ts",
    "intake:example": "tsx src/cli.ts intake apply-answers --answers examples/engagement-answers.example.json --out .tmp/client.config.from-answers.json --strict",
    "e2e": "playwright test",
    "e2e:full": "cross-env E2E_FULL=1 playwright test",
    "e2e:smoke": "tsx --test src/e2e/j2-smoke.test.ts",
    "ci": "npm run build && npm run validate:example && npm run generate:example && npm run intake:example && npm run check-brand:clean && npm run check-seo:fixtures && npm run test:unit",
    "pitch:verify": "tsx web/scripts/verify-pitch.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "firebase-admin": "^13.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
