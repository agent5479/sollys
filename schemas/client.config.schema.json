{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whitelabel.local/schemas/client.config.schema.json",
  "title": "White-label Client Pack intake",
  "description": "Machine-readable §B1–B5 intake plus lineage, SEO policy, productCore roles, and previous-brand tokens. Structural slots only — themed content is filled at engagement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["brand", "style", "locale", "infra", "seo", "templateLineage"],
  "properties": {
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shortName",
        "contactName",
        "contactRole",
        "notifyEmail",
        "phone",
        "phoneHref",
        "venues",
        "origin",
        "appBase"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string" },
        "hashtag": { "type": "string" },
        "voice": { "type": "string" },
        "voiceSamples": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0
        },
        "contactName": { "type": "string", "minLength": 1 },
        "contactRole": { "type": "string", "minLength": 1 },
        "contactBio": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0
        },
        "legalEntityName": { "type": "string" },
        "copyrightText": { "type": "string" },
        "notifyEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string", "minLength": 1 },
        "phoneHref": { "type": "string", "pattern": "^tel:" },
        "social": {
          "type": "object",
          "additionalProperties": { "type": "string", "format": "uri" }
        },
        "venues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "address"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "address": { "type": "string", "minLength": 1 },
              "geo": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lat", "lng"],
                "properties": {
                  "lat": { "type": "number" },
                  "lng": { "type": "number" }
                }
              }
            }
          }
        },
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+$"
        },
        "appBase": {
          "type": "string",
          "pattern": "^/.*/$"
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logoLight", "logoDark", "favicon", "appIcon"],
          "properties": {
            "logoLight": { "type": "string", "minLength": 1 },
            "logoDark": { "type": "string", "minLength": 1 },
            "favicon": { "type": "string", "minLength": 1 },
            "appIcon": { "type": "string", "minLength": 1 },
            "logoWidth": { "type": "number", "minimum": 1 },
            "logoHeight": { "type": "number", "minimum": 1 }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["themeClass", "ink", "paper", "muted", "line", "accent", "fonts"],
      "properties": {
        "themeClass": {
          "type": "string",
          "pattern": "^theme-[a-z0-9-]+$"
        },
        "ink": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "paper": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "muted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "line": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "secondary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display", "body"],
          "properties": {
            "display": { "type": "string", "minLength": 1 },
            "body": { "type": "string", "minLength": 1 },
            "source": { "type": "string" }
          }
        },
        "radii": { "type": "string" },
        "motion": { "type": "string" },
        "logoPath": { "type": "string" },
        "ogImagePath": { "type": "string" },
        "iconApproach": { "type": "string" }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uiStringsPath": { "type": "string" },
        "emailCopyPath": { "type": "string" },
        "roleLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "paymentInstructions": { "type": "string" },
        "classCatalogPath": { "type": "string" },
        "classCatalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "blurb"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "blurb": { "type": "string" },
              "licensed": { "type": "boolean" }
            }
          }
        },
        "licensedCatalogAcknowledged": { "type": "boolean" }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeZone", "locale", "currency", "functionsRegion"],
      "properties": {
        "timeZone": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 2 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "functionsRegion": { "type": "string", "minLength": 1 },
        "operatingHours": { "type": "string" },
        "seasonsNotes": { "type": "string" },
        "seasonModel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["termCalendar", "customRanges", "manual"]
            },
            "notes": { "type": "string" },
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "start", "end"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "start": { "type": "string", "minLength": 1 },
                  "end": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "infra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firebaseProjectId", "hosting"],
      "properties": {
        "googleAccount": { "type": "string" },
        "calendarStrategy": { "type": "string" },
        "firebaseProjectId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "hosting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "customDomain": { "type": "string" },
            "dnsOwner": { "type": "string" }
          }
        },
        "aiCrawlerPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowCitationBots": { "type": "boolean" },
            "disallowTrainingBots": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "signInPath": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/$"
        },
        "callableOrigins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "packageIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["npmRoot", "sharedAlias"],
          "properties": {
            "npmRoot": { "type": "string", "minLength": 1 },
            "npmApps": { "type": "string" },
            "npmFunctions": { "type": "string" },
            "sharedAlias": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteTitle", "siteDescription", "defaultOgImage", "routes"],
      "properties": {
        "siteTitle": { "type": "string", "minLength": 1 },
        "siteDescription": { "type": "string", "minLength": 1 },
        "defaultOgImage": { "type": "string", "minLength": 1 },
        "twitterHandle": { "type": "string" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "title", "description"],
            "properties": {
              "path": { "type": "string", "pattern": "^/" },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "ogImage": { "type": "string" }
            }
          }
        }
      }
    },
    "templateLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstreamCommit"],
      "properties": {
        "upstreamRepo": { "type": "string" },
        "upstreamCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "toolkitVersion": { "type": "string" },
        "forkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stack": {
          "type": "string",
          "enum": ["booking", "publicSheetCalendar", "hybrid"]
        },
        "surfaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "marketing": { "type": "boolean" },
            "memberApp": { "type": "boolean" },
            "staffConsole": { "type": "boolean" },
            "emailCalendar": { "type": "boolean" },
            "manualPayments": { "type": "boolean" }
          }
        },
        "mPatterns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "terminology": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "assumptionsAuthorized": { "type": "boolean" },
        "infraBoundaryConfirmed": { "type": "boolean" }
      }
    },
    "productCore": {
      "type": "object",
      "additionalProperties": false,
      "description": "Structural Product Core inventory for booking stack; applied after S2 surface selection.",
      "properties": {
        "marketing": { "type": "boolean" },
        "memberApp": { "type": "boolean" },
        "staffConsole": { "type": "boolean" },
        "sharedClient": { "type": "boolean" },
        "functions": { "type": "boolean" },
        "firestoreRules": { "type": "boolean" },
        "firestoreIndexes": { "type": "boolean" },
        "rulesTests": { "type": "boolean" },
        "appsScript": { "type": "boolean" },
        "seedScripts": { "type": "boolean" },
        "adminBootstrap": { "type": "boolean" },
        "pagesAssemble": { "type": "boolean" }
      }
    },
    "previousBrand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "emails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "phones": {
          "type": "array",
          "items": { "type": "string" }
        },
        "themeClass": { "type": "string" },
        "prodIdDomain": { "type": "string" },
        "fingerprintHexes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" }
        },
        "allowPaths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "adminBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "uid": { "type": "string" }
      }
    }
  }
}
